    {
      "name": "Module 3 - Subscription Plan Management",
      "item": [
        {
          "name": "Get Plan Metrics (Admin & Staff)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/plans/metrics/",
              "host": ["{{base_url}}"],
              "path": ["plans", "metrics", ""]
            },
            "description": "Returns aggregated plan counts (total, active, paused, closed, currently available) and billing interval distribution."
          }
        },
        {
          "name": "List Subscription Plans (Admin & Staff)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/plans/?search=&billing_interval=&status=&available_only=",
              "host": ["{{base_url}}"],
              "path": ["plans", ""],
              "query": [
                { "key": "search", "value": "", "description": "Filter by plan name, code, product name, or variant" },
                { "key": "billing_interval", "value": "", "description": "DAILY, WEEKLY, MONTHLY, or YEARLY" },
                { "key": "status", "value": "", "description": "ACTIVE, PAUSED, CLOSED, or INACTIVE" },
                { "key": "available_only", "value": "", "description": "Set to true to show only currently open plans" }
              ]
            },
            "description": "Lists paginated subscription plans with filtering, search, and sorting capabilities."
          }
        },
        {
          "name": "Create Subscription Plan (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Accounting Basic Monthly\",\n  \"description\": \"Core accounting software subscription with monthly billing.\",\n  \"product\": 1,\n  \"variant\": 1,\n  \"price\": \"500.00\",\n  \"currency\": \"INR\",\n  \"billing_interval\": \"MONTHLY\",\n  \"minimum_quantity\": 1,\n  \"available_from\": \"2026-01-01\",\n  \"available_until\": null,\n  \"auto_close\": true,\n  \"allow_early_closure\": true,\n  \"allow_pause\": true,\n  \"allow_renewal\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/plans/",
              "host": ["{{base_url}}"],
              "path": ["plans", ""]
            },
            "description": "Creates a new subscription plan with lifecycle policies and billing intervals."
          }
        },
