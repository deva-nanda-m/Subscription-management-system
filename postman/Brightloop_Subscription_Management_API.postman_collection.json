            "url": {
              "raw": "{{base_url}}/plans/1/",
              "host": ["{{base_url}}"],
              "path": ["plans", "1", ""]
            },
            "description": "Retrieves comprehensive subscription plan details including associated product/variant and lifecycle audit trail."
          }
        },
        {
          "name": "Update Subscription Plan (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Accounting Basic Monthly (Updated)\",\n  \"price\": \"550.00\",\n  \"minimum_quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/plans/1/",
              "host": ["{{base_url}}"],
              "path": ["plans", "1", ""]
            },
            "description": "Partially updates an existing subscription plan. Closed plans cannot be updated."
          }
        },
        {
          "name": "Pause Plan (Admin Only)",
