# ==========================================
# Brightloop Software - Environment Settings
# ==========================================

# Django Security
SECRET_KEY=brightloop-dev-secret-key-change-in-production-!#9x8v$72
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Database Settings (PostgreSQL)
# For local development without a running PostgreSQL instance, DB_ENGINE can be set to 'sqlite'
DB_ENGINE=django.db.backends.postgresql
DB_NAME=brightloop_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Celery & Redis (Task Scheduling & Background Workers)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Configuration
# Development options: 'django.core.mail.backends.console.EmailBackend' (prints to terminal)
# Production options: 'django.core.mail.backends.smtp.EmailBackend'
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@brightloopsoftware.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Brightloop Support <noreply@brightloopsoftware.com>

# Initial Administrator Credentials (used by: python manage.py initadmin)
INITIAL_ADMIN_EMAIL=admin@brightloop.com
INITIAL_ADMIN_PASSWORD=Admin@Brightloop2026!
INITIAL_ADMIN_NAME=System Administrator
